<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/colorSurfaceContainerLow">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/script_name_label"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/script_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/script_name_hint"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/script_content_label"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/script_content"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:hint="@string/script_content_hint"
        android:inputType="textMultiLine"
        android:gravity="top|start" />

</LinearLayout>